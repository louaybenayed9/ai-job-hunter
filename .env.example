# =========================================================================
# AI Job Hunter - environment configuration
# Usage:  cp .env.example .env   then edit the values marked CHANGE ME
# =========================================================================

# ---------- General -----------------------------------------------------
TZ=Africa/Tunis
LOG_LEVEL=info

# ---------- PostgreSQL (pgvector) ---------------------------------------
POSTGRES_DB=ai_job_hunter
POSTGRES_USER=ai_job_hunter
# CHANGE ME: any non-empty password
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# ---------- n8n ---------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
# CHANGE ME: 32+ random chars, e.g. `openssl rand -hex 24`
# Used to encrypt credentials stored in n8n - losing it locks you out of saved credentials.
N8N_ENCRYPTION_KEY=change_me_32_char_random_hex_key_here
N8N_DIAGNOSTICS_ENABLED=false
N8N_EXECUTIONS_MAX_AGE_HOURS=168

# ---------- Scraper service --------------------------------------------
SCRAPER_PORT=8000
SCRAPE_DELAY_SECONDS=1.0
SCRAPE_TIMEOUT_SECONDS=20
SCRAPE_MAX_PAGES=3
SCRAPE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36

# ---------- AI service (LLM layer) --------------------------------------
AI_PORT=8001
# openrouter | gemini
LLM_PROVIDER=openrouter
# OpenRouter model id - must still exist on https://openrouter.ai/models
# (a retired id fails scoring with HTTP 404 "No endpoints found").
# Verified free options: nvidia/nemotron-3-super-120b-a12b:free, cohere/north-mini-code:free
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_TIMEOUT_SECONDS=60
# CHANGE ME - at least one of these two keys
# OpenRouter key:   https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Gemini key:       https://aistudio.google.com/apikey  (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# ---------- Scoring threshold -------------------------------------------
# Job match score (0-100) at or above which a job is notified (Telegram/Sheets).
# Single source of truth: consumed by BOTH the ai-service (`notify` flag)
# and the n8n IF node ("match_score >= MATCH_SCORE_THRESHOLD").
MATCH_SCORE_THRESHOLD=75

# ---------- Notifications (Telegram) ------------------------------------
# 1. Create a bot with @BotFather -> it replies with a token like 123456:ABC-DEF...
TELEGRAM_BOT_TOKEN=
# 2. Get your chat id: send your bot any message, then open
#    https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates
#    and copy result[].message.chat.id (negative for group chats).
#    Or simply ask @userinfobot / @getmyid_bot in Telegram.
TELEGRAM_CHAT_ID=
# Google Sheets output is configured through the n8n "Google Sheets" node
# (OAuth2 credential). These only address the target sheet.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Sheet1
